---
// Admin: live PR preview namespaces. Previews expire on their own and the
// papyri action drops one when its pull request closes; this page is the
// manual override and the audit view. Registering the workflows allowed to
// create them is project-level self-service and lives on /settings.
import AdminLayout from "../../layouts/AdminLayout.astro";
import PreviewsPanel from "../../components/PreviewsPanel.tsx";
import { getAuthDb } from "../../lib/auth-db.ts";
import { parsePreviewId, previewBase } from "../../lib/preview.ts";
import { previewBundles } from "../../lib/preview-store.ts";

export const prerender = false;

const auth = await getAuthDb();
const previews = await Promise.all(
  auth.listPreviews().map(async (row) => {
    const ref = parsePreviewId(row.id);
    return {
      ...row,
      base: ref ? previewBase(ref) : "",
      bundles: ref ? await previewBundles(ref) : [],
    };
  })
);
---

<AdminLayout title="Admin · Previews — Papyri" active="previews">
  <section class="admin-section">
    <h2>PR previews</h2>
    <PreviewsPanel client:load initialPreviews={previews} />
  </section>

  <section class="admin-section">
    <h2>Trusted publishers</h2>
    <p class="admin-help">
      Which GitHub workflows may publish previews (and releases) lives with the projects themselves,
      on <a href="/settings">your settings page</a> — a project member registers their own repository
      there; as an admin you see every project's.
    </p>
  </section>
</AdminLayout>
